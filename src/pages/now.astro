---
// Now. While the Now page is switched off its address answers "not found" (the Worker, see the layout).
import Desktop from "../layouts/Desktop.astro";
import { day, now, site } from "../lib/content";
import { home } from "../lib/desktop";
---
<Desktop page="now" open={now.show ? "now" : (await home()).key} title="Now" description={`What ${site.name} is doing now. Updated ${day(now.updated)}.`} />
